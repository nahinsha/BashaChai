# Copy to .env and set BASACHAI_ENV=development in your shell before starting Django.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configure DATABASE_URL or DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, and DB_PORT
# for your local PostgreSQL instance. No real credentials belong in this file.

# DJANGO_SECRET_KEY is optional in debug mode; Django generates a temporary key.
