[Unit]
Description=Refresh stale BasaChai listing availability
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=basachai
Group=basachai
WorkingDirectory=/opt/basachai/backend
EnvironmentFile=/etc/basachai/backend.env
ExecStart=/opt/basachai/backend/.venv/bin/python manage.py refresh_listing_availability
